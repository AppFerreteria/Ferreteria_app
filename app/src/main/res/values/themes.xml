<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Ferreteria_app" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Ferreteria_app" parent="Base.Theme.Ferreteria_app" />

    <style name="TextStepDone">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_step_done</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStepActive">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_step_active</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStepPending">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_step_pending</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/payment_text_gray</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LineStepDone">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:background">@color/blue_primary</item>
    </style>

    <style name="LineStepPending">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:background">#E5E7EB</item>
    </style>
</resources>