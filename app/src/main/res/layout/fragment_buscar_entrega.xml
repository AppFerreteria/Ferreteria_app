<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Cabecera -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeaderEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvEmpresaLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:text="@string/empresa_titulo"
            android:textColor="@color/brand_brown"
            android:textSize="18sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_martillo"
            app:drawableTint="@color/brand_brown"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/brand_brown" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Titulo Principal -->
    <TextView
        android:id="@+id/tvTituloBuscarEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/titulo_buscar_entrega"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/clHeaderEntrega" />

    <!-- Barra de Busqueda Compuesta -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBarraBusqueda"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_bar_entrega"
        app:layout_constraintTop_toBottomOf="@id/tvTituloBuscarEntrega">

        <ImageView
            android:id="@+id/ivIconoSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@android:drawable/ic_menu_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_hint_gray" />

        <EditText
            android:id="@+id/etNumeroOrden"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="12dp"
            android:background="@android:color/transparent"
            android:hint="@string/hint_numero_orden"
            android:inputType="textCapCharacters"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/btnBuscarOrden"
            app:layout_constraintStart_toEndOf="@id/ivIconoSearch" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarOrden"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_buscar_orden"
            android:textAllCaps="false"
            app:backgroundTint="@color/brand_orange"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ESTADO 1: Sin busqueda aun -->
    <LinearLayout
        android:id="@+id/llEstadoInicial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/clBarraBusqueda">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Ingresa un numero de orden\npara ver el estado de la entrega"
            android:textColor="@color/text_hint_gray"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ESTADO 2: Contenedor de Busqueda Skeleton -->
    <LinearLayout
        android:id="@+id/llContenedorCarga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/clBarraBusqueda"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_buscando_pedido"
                android:textColor="@color/brand_brown"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/brand_brown"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:cardBackgroundColor="#F0F0F0"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <View
                    android:layout_width="150dp"
                    android:layout_height="16dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp" />
                <View
                    android:layout_width="100dp"
                    android:layout_height="12dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="24dp" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="16dp" />
                <View
                    android:layout_width="80dp"
                    android:layout_height="16dp"
                    android:background="#E0E0E0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ESTADO 3: Resultado encontrado -->
    <LinearLayout
        android:id="@+id/llResultadoEncontrado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clBarraBusqueda"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvNumeroPedidoEncontrado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Pedido #NN-001" />

        <TextView
            android:id="@+id/tvDescripcionEncontrada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_hint_gray"
            android:textSize="13sp"
            tools:text="3 items encontrados" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItemsEncontrados"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarEntrega"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="Iniciar Entrega"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_brown"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarcarEntregadoBusqueda"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:text="Marcar como Entregado"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/green_descuento"
            app:cornerRadius="12dp"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Sin resultados -->
    <LinearLayout
        android:id="@+id/llSinResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/clBarraBusqueda">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/error_orden_no_encontrada"
            android:textColor="@color/text_hint_gray"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
