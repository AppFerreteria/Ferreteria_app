<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/payment_background"
    android:padding="28dp">

    <LinearLayout
        android:id="@+id/contenidoProceso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp">

            <ProgressBar
                android:id="@+id/progressProcesandoPago"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true" />

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_step_active"
                android:gravity="center"
                android:text="⚡"
                android:textSize="28sp" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Procesando tu pago"
            android:textColor="@color/payment_text_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Estamos verificando tu transacción de forma segura. Por favor espera..."
            android:textColor="@color/payment_text_gray"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvPasoValidando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/payment_text_gray"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvPasoPasarela"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/payment_text_gray"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvPasoProcesando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/payment_text_gray"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvPasoComprobante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/payment_text_gray"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="🔒 Transacción protegida por SSL 256-bit"
            android:textColor="@color/payment_text_gray"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
