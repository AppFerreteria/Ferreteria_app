<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/payment_background">

    <LinearLayout
        android:id="@+id/headerResultado"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:background="@drawable/bg_success_header"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvIconResultado"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/white"
            android:textSize="58sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultadoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvResultadoSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/brand_footer"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvMontoResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_total_box"
            android:paddingHorizontal="28dp"
            android:paddingVertical="12dp"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerResultado"
        app:layout_constraintBottom_toTopOf="@id/footerResultado">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/cardDetalleResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detalles de la transacción"
                    android:textColor="@color/payment_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOperacionResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="@color/payment_text_dark"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvMetodoResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/payment_text_dark"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvFechaResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/payment_text_dark"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvEstadoResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/green_success"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBannerPedidoCamino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chip_green"
                android:padding="16dp"
                android:text="🚚 Tu pedido está en camino. Recibirás una notificación cuando salga a despacho."
                android:textColor="@color/green_success"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/footerResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="18dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccionResultado"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/green_success"
            app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
